flowchart TD
    SIGNUP["POST /api/v1/producers<br>PENDING + 인증 메일 발송"] --> VERIFY["GET /api/v1/auth/email-verifications<br>302 redirect"]
    VERIFY --> LOGIN_FORM["로그인 화면"]
    LOGIN_FORM --> FORGOT{"비밀번호 분실?"}
    FORGOT -- 예 --> RESET_MAIL["POST /api/v1/auth/password-resets<br>재설정 메일 발송"]
    RESET_MAIL --> RESET["GET token 확인 → PATCH 새 비밀번호"]
    RESET --> LOGIN_FORM
    FORGOT -- 아니오 --> LOGIN["POST /api/v1/sessions"]
    LOGIN --> PERFORMANCE["공연 관리"]
    PERFORMANCE --> AUDITION["공고 기본 정보·배역·일정·지원 폼 저장"]
    AUDITION --> PUBLISH["PUT /api/v1/auditions/{auditionId}/publication"]
    PUBLISH --> ROLE["공고 배역별 지원 현황"]
    ROLE --> BOARD["GET .../screening-rounds/{round}/submissions"]
    BOARD --> FOCUS["카드 · 표 · 한 명씩 보기\n검색·필터 조건과 URL 상태 보존"]
    FOCUS --> REVIEW
    BOARD --> REVIEW["PATCH .../screening-rounds/{round}/reviews"]
    REVIEW --> COMPLETE["현재 차수 마감<br>PATCH .../screening-rounds/{round}/completion"]
    COMPLETE --> NEXT{"다음 차수 PASS 지원자?"}
    NEXT -- 예 --> BOARD
    NEXT -- 아니오 --> LOCKED["남은 빈 차수 자동 마감·배역 전형 종료"]
    COMPLETE --> CURRENT_LOCKED["마감한 차수 결과 수정 잠금"]
