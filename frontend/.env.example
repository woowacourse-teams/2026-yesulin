# Server-only origin used by Next.js rewrites and server rendering.
API_ORIGIN=http://localhost:8080

# MSW is opt-in. Set enabled only for mock scenario development.
NEXT_PUBLIC_API_MOCKING=

# When MSW is enabled, these flags selectively use the real backend.
NEXT_PUBLIC_PRODUCER_LOGIN=
NEXT_PUBLIC_PRODUCER_API=
NEXT_PUBLIC_APPLICANT_PROFILE_API=
NEXT_PUBLIC_SOCIAL_LOGIN=

# Browser key for the Kakao Maps JavaScript SDK.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Google Tag Manager container ID. Set only where analytics should run.
NEXT_PUBLIC_GTM_ID=

# Free plan: one project, mandatory environment filters separate production/development. No key means disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENV=development
# Server-only: enable only after project setup and the applicable privacy notice are ready.
POSTHOG_COLLECTION_ENABLED=false
# Generate a different random secret (at least 32 characters) per environment. Never expose it publicly.
POSTHOG_IDENTITY_SECRET=
# Comma-separated internal member IDs, never email addresses. ADMIN is always internal.
POSTHOG_INTERNAL_MEMBER_IDS=
# Example: post_id:123,show_id:uuid,review_id:456
POSTHOG_TEST_OBJECTS=
# Verified support-form attachments, indexed from zero. Empty list means reference files only.
# Example JSON: {"123":[0],"124":[]}. Unlisted posts remain unclassified.
POSTHOG_FORM_ATTACHMENTS={}

# Public project DSN used by browser, Next.js server, and edge runtimes.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Source-map upload settings. SENTRY_AUTH_TOKEN is secret and must stay in the deployment environment.
SENTRY_ORG=in-front
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# Local verification only. Do not enable this route in Production or Preview.
SENTRY_EXAMPLE_ENABLED=
