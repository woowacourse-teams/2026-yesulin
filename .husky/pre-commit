#!/bin/sh
set -eu

sh scripts/config/validate-pin.sh --local

changed_files=$(git diff --cached --name-only --diff-filter=ACMR -- \
  backend/src \
  backend/checkstyle \
  backend/build.gradle.kts)

if printf '%s\n' "$changed_files" | grep -Eq '(^backend/src/.*\.java$|^backend/checkstyle/|^backend/build\.gradle\.kts$)'; then
  npm run checkstyle
else
  echo "백엔드 Java 또는 Checkstyle 변경이 없어 검사를 건너뜁니다."
fi
