if ! command -v node >/dev/null 2>&1; then
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      for node_directory in "/c/Program Files/nodejs" "/c/Program Files (x86)/nodejs"; do
        if [ -x "$node_directory/node.exe" ]; then
          PATH="$node_directory:$PATH"
          export PATH
          break
        fi
      done
      ;;
  esac
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js를 찾을 수 없습니다. Git 클라이언트를 다시 시작하거나 Node.js PATH를 확인해 주세요."
  exit 1
fi

node node_modules/@commitlint/cli/cli.js --edit "$1"
