# Local backend database. Fill the password in the untracked .env file.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=3307
DB_NAME=yesulin
DB_USERNAME=yesulin
DB_PASSWORD=

# OIDC credentials for local development. Never commit real values.
SOCIAL_LOGIN_ENABLED=true
SOCIAL_LOGIN_REDIRECT_URI=http://localhost:3000/login/oauth2/code/{registrationId}
SOCIAL_LOGIN_SUCCESS_REDIRECT=http://localhost:3000/social-login/complete
KAKAO_OIDC_CLIENT_ID=
KAKAO_OIDC_CLIENT_SECRET=
NAVER_OIDC_CLIENT_ID=
NAVER_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
