# Local backend database. Fill the password in the untracked .env file.
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=3307
DB_NAME=yesulin
DB_USERNAME=yesulin
DB_PASSWORD=

# OIDC credentials for local development. Never commit real values.
SOCIAL_LOGIN_ENABLED=true
NEXT_PUBLIC_API_MOCKING=
NEXT_PUBLIC_SOCIAL_LOGIN=disabled
SOCIAL_LOGIN_REDIRECT_URI=http://localhost:3000/login/oauth2/code/{registrationId}
SOCIAL_LOGIN_SUCCESS_REDIRECT=http://localhost:3000/social-login/complete
KAKAO_OIDC_CLIENT_ID=
KAKAO_OIDC_CLIENT_SECRET=
NAVER_OIDC_CLIENT_ID=
NAVER_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Google SMTP email verification. Use a Google app password, never the account password.
EMAIL_VERIFICATION_EXPIRATION=PT5M
EMAIL_VERIFICATION_URL=http://localhost:8080/api/v1/auth/email-verifications
GOOGLE_SMTP_USERNAME=
GOOGLE_SMTP_APP_PASSWORD=
GOOGLE_SMTP_FROM=

# Kakao Maps JavaScript SDK key used by the browser frontend.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
