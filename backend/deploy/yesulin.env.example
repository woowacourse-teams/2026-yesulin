# DEV 예시 파일이다. 실제 값은 config 저장소의 server/dev.env 또는 server/prod.env를 SOPS로 편집한다.
# EC2의 /opt/yesulin/current/yesulin.env를 직접 수정하지 않는다.
# 실제 자격 증명은 이 파일이나 애플리케이션 저장소에 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://MYSQL_PRIVATE_HOST:3306/yesulin
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
YESULIN_STORAGE_S3_BUCKET=techcourse-project-2026
YESULIN_STORAGE_S3_KEY_PREFIX=yesulin
YESULIN_STORAGE_S3_PUBLIC_BASE_URL=https://dcijkydwh7e79.cloudfront.net
YESULIN_STORAGE_S3_UPLOAD_EXPIRATION=PT10M
# 선택. 공개 파일 CDN 배포 ID. 넣으면 배우 페이지 사진 사본을 지울 때 무효화를 요청한다. 비우면 끈다.
# 서버 실행 역할에 cloudfront:CreateInvalidation 권한이 있어야 한다.
YESULIN_STORAGE_CLOUDFRONT_DISTRIBUTION_ID=
AWS_REGION=ap-northeast-2
AWS_EC2_METADATA_V1_DISABLED=true
SOCIAL_LOGIN_ENABLED=true
SOCIAL_LOGIN_REDIRECT_URI=https://yesulin.art/login/oauth2/code/{registrationId}
SOCIAL_LOGIN_SUCCESS_REDIRECT=https://yesulin.art/social-login/complete
SOCIAL_LOGIN_FAILURE_REDIRECT=https://yesulin.art/login?socialLoginError=true
EMAIL_VERIFICATION_EXPIRATION=PT5M
EMAIL_VERIFICATION_URL=https://api.example.com/api/v1/auth/email-verifications
EMAIL_VERIFICATION_REDIRECT_URI=https://example.com/producers
PASSWORD_RESET_EXPIRATION=PT5M
PASSWORD_RESET_URL=https://example.com/forgot-password
GOOGLE_SMTP_USERNAME=CHANGE_ME
GOOGLE_SMTP_APP_PASSWORD=CHANGE_ME
GOOGLE_SMTP_FROM=CHANGE_ME
# 세션 Cookie에 Secure 속성을 붙인다. HTTPS 환경에서는 반드시 true여야 한다.
SESSION_COOKIE_SECURE=true
# 마지막 요청 이후 세션을 유지할 idle timeout이다.
SESSION_TIMEOUT=12h
# 운영 대시보드 계정. `email:password`이고 여러 개는 쉼표로 잇는다. 비밀번호에는 쉼표를 쓸 수 없다.
YESULIN_ADMIN_ACCOUNTS=admin@yesulin.art:CHANGE_TO_A_LONG_PASSPHRASE
# `scripts/generate-admin-deletion-password-hash.ps1`이 출력한 BCrypt 해시만 넣는다. 원문은 넣지 않는다.
YESULIN_ADMIN_DELETION_PASSWORD_HASH=CHANGE_TO_BCRYPT_HASH
# 공고 Slack 알림을 활성화할 때 DEV의 암호화된 설정에만 실제 URL을 입력한다.
# YESULIN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# LOCAL·DEV 오류/지원자 분석 실패는 같은 개발 채널 웹훅을 사용한다. 실제 값은 비밀 설정에만 둔다.
# YESULIN_ERROR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# YESULIN_PDF_AI_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# YESULIN_PDF_AI_SLACK_RETRY_BASE_URL=https://dev.yesulin.art
# YESULIN_PDF_AI_MODEL_ID=global.openai.gpt-6-luna
# YESULIN_PDF_AI_REASONING_EFFORT=none
# DEV 기본값. 기존 명시값이 있으면 이것보다 우선한다. 전체 모델/재시도 합산 1RPS.
# YESULIN_PDF_AI_REQUEST_INTERVAL=PT1S
# YESULIN_PDF_AI_ESCALATION_ENABLED=true
# YESULIN_PDF_AI_ESCALATION_MODEL_ID=global.openai.gpt-6-sol
# YESULIN_PDF_AI_ESCALATION_REASONING_EFFORT=low
# YESULIN_PDF_AI_ESCALATION_MAX_TOKENS=8192
# YESULIN_PDF_AI_CIRCUIT_ENABLED=true
# YESULIN_PDF_AI_CIRCUIT_FAILURE_THRESHOLD=3
# YESULIN_PDF_AI_CIRCUIT_OPEN_DURATION=PT60S
# YESULIN_PDF_AI_CIRCUIT_MAX_OPEN_DURATION=PT5M
# 필수. DEV에서 보내는 공고 알림도 PROD 링크를 사용한다. SOPS config에 환경별로 설정한다.
YESULIN_NOTICE_LINK_BASE_URL=https://yesulin.art
# 선택. 공연예술통합전산망(KOPIS) Open API 인증키. 운영자 공연사 정보 쓰기의 처음 값을 KOPIS에서 찾는다. 비우면 끈다.
KOPIS_API_KEY=
# 선택. JVM 옵션. DEV는 힙 상한 `-Xmx384m`을 두고, PROD는 빈 값으로 둔다.
JAVA_TOOL_OPTIONS=-Xmx384m

# dev/prod에서 기본 활성화. 1분 주기 JVM/Tomcat/Hikari/GC JSON 로그를 끌 때 false로 설정한다.
YESULIN_MONITORING_ENABLED=true

# 선택. PDF 추출 기능. 기본 false이고 true일 때만 /internal/v1/pdf-extractions/** 완료 callback 체인을 등록한다.
YESULIN_PDF_EXTRACTION_ENABLED=false
# PDF 추출 Lambda의 PDF_COMPLETION_API_TOKEN과 같은 32자 이상 공백 없는 값. 실제 값은 SOPS 암호화된 env에만 넣는다.
# 비우거나 짧으면 callback 요청을 모두 401로 거부한다.
YESULIN_PDF_EXTRACTION_CALLBACK_SECRET=CHANGE_ME
