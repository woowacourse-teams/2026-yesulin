# Copy this file to /etc/yesulin/yesulin.env on the EC2 instance.
# Never commit real credentials.
SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:mysql://MYSQL_PRIVATE_HOST:3306/yesulin
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
YESULIN_STORAGE_S3_BUCKET=techcourse-project-2026
YESULIN_STORAGE_S3_KEY_PREFIX=yesulin
YESULIN_STORAGE_S3_PUBLIC_BASE_URL=https://dcijkydwh7e79.cloudfront.net
YESULIN_STORAGE_S3_UPLOAD_EXPIRATION=PT10M
AWS_REGION=ap-northeast-2
AWS_EC2_METADATA_V1_DISABLED=true
YESULIN_CLOUDFRONT_ORIGIN_SECRET=CHANGE_TO_64_HEXADECIMAL_CHARACTERS
EMAIL_VERIFICATION_EXPIRATION=PT5M
EMAIL_VERIFICATION_URL=https://api.example.com/api/v1/auth/email-verifications
EMAIL_VERIFICATION_REDIRECT_URI=https://example.com/producers
GOOGLE_SMTP_USERNAME=CHANGE_ME
GOOGLE_SMTP_APP_PASSWORD=CHANGE_ME
GOOGLE_SMTP_FROM=CHANGE_ME
# 세션 Cookie에 Secure 속성을 붙인다. HTTPS 환경에서는 반드시 true여야 한다.
SESSION_COOKIE_SECURE=true
# 운영 대시보드 계정. `email:password`이고 여러 개는 쉼표로 잇는다. 비밀번호에는 쉼표를 쓸 수 없다.
YESULIN_ADMIN_ACCOUNTS=admin@yesulin.art:CHANGE_TO_A_LONG_PASSPHRASE
