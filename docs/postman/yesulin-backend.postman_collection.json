{
  "info": {
    "name": "예술IN Backend - Integrated API",
    "description": "Frontend/MSW와 공유하는 /api/v1 계약의 실제 Backend happy path입니다. 폴더와 요청을 번호 순서대로 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "csrfToken", "value": "" },
    { "key": "producerEmail", "value": "postman-producer@example.com" },
    { "key": "producerPassword", "value": "postman1234" },
    { "key": "applicantEmail", "value": "postman-applicant@example.com" },
    { "key": "applicantPassword", "value": "postman1234" },
    { "key": "performanceId", "value": "1" },
    { "key": "roleTemplateId", "value": "1" },
    { "key": "postingId", "value": "1" },
    { "key": "roleId", "value": "1" },
    { "key": "draftId", "value": "1" },
    { "key": "applicationId", "value": "1" }
  ],
  "item": [
    {
      "name": "01. 세션과 계정",
      "item": [
        {
          "name": "현재 세션 및 CSRF 준비",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sessions/current" }
        },
        {
          "name": "공연사 가입",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{producerEmail}}\",\n  \"password\": \"{{producerPassword}}\",\n  \"companyName\": \"Postman 공연사\",\n  \"businessNumber\": \"111-22-33333\",\n  \"representativeName\": \"테스트 대표\",\n  \"contactName\": \"테스트 담당자\"\n}" },
            "url": "{{baseUrl}}/api/v1/producers"
          }
        },
        {
          "name": "공연사 로그인",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{producerEmail}}\",\n  \"password\": \"{{producerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions"
          }
        },
        { "name": "공연사 프로필", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/producers/me" } }
      ]
    },
    {
      "name": "02. 공연과 공고",
      "item": [
        {
          "name": "공연과 배역 템플릿 생성",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('performanceId', body.id);",
            "pm.collectionVariables.set('roleTemplateId', body.roleTemplates[0].id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman 통합 공연\",\n  \"venue\": \"테스트 극장\",\n  \"posterUrl\": \"https://example.com/poster.jpg\",\n  \"roles\": [{ \"name\": \"주연\", \"description\": \"\", \"gender\": \"ANY\", \"ageMin\": 18, \"ageMax\": 40 }]\n}" },
            "url": "{{baseUrl}}/api/v1/performances"
          }
        },
        {
          "name": "공고·배역·차수·필드 생성",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('postingId', body.id);",
            "pm.collectionVariables.set('roleId', body.roles[0].id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman 통합 공고\",\n  \"status\": \"OPEN\",\n  \"allowsMultipleRoles\": false,\n  \"recruitmentStartsAt\": \"2026-01-01T00:00:00+09:00\",\n  \"recruitmentEndsAt\": \"2027-01-01T00:00:00+09:00\",\n  \"applicationGuide\": \"통합 검증 공고\",\n  \"roles\": [{ \"templateId\": {{roleTemplateId}}, \"quota\": 2 }],\n  \"rounds\": [{ \"round\": 1, \"name\": \"서류\", \"date\": \"2027-01-02\", \"note\": \"\" }],\n  \"applicationFields\": [\n    { \"key\": \"NAME\", \"label\": \"이름\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"TEXT\", \"order\": 10, \"config\": {} },\n    { \"key\": \"PHONE\", \"label\": \"연락처\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"TEL\", \"order\": 20, \"config\": {} },\n    { \"key\": \"BIRTH\", \"label\": \"생년월일\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"DATE\", \"order\": 30, \"config\": {} },\n    { \"key\": \"GENDER\", \"label\": \"성별\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"SELECT\", \"order\": 40, \"config\": {} },\n    { \"key\": \"BODY\", \"label\": \"키·몸무게\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"COMPOSITE\", \"order\": 50, \"config\": {} },\n    { \"key\": \"EMAIL\", \"label\": \"이메일\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"TEXT\", \"order\": 60, \"config\": {} },\n    { \"key\": \"RESIDENCE\", \"label\": \"거주지\", \"required\": true, \"custom\": false, \"section\": \"BASIC\", \"inputType\": \"TEXT\", \"order\": 70, \"config\": {} }\n  ]\n}" },
            "url": "{{baseUrl}}/api/v1/performances/{{performanceId}}/postings"
          }
        },
        { "name": "공연 목록", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/performances" } },
        { "name": "공고 상세", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/postings/{{postingId}}" } },
        { "name": "공개 공고 상세", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/public/postings/{{postingId}}" } }
      ]
    },
    {
      "name": "03. 지원자 Draft와 제출",
      "item": [
        {
          "name": "지원자 가입",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{applicantEmail}}\",\n  \"password\": \"{{applicantPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/applicants"
          }
        },
        {
          "name": "지원자 로그인",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{applicantEmail}}\",\n  \"password\": \"{{applicantPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions"
          }
        },
        {
          "name": "프로필 저장",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"activityName\": \"테스트 배우\", \"name\": \"지원자\", \"height\": 170, \"weight\": 60,\n  \"birthDate\": \"2000-01-01\", \"gender\": \"FEMALE\", \"phone\": \"010-1234-5678\",\n  \"email\": \"{{applicantEmail}}\", \"residence\": \"서울\", \"additionalInformation\": {}, \"photoUrls\": [],\n  \"profileSaveConsent\": true\n}" },
            "url": "{{baseUrl}}/api/v1/applicants/me/profile"
          }
        },
        {
          "name": "Draft 생성",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('draftId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"postingId\": {{postingId}},\n  \"content\": { \"roleIds\": [{{roleId}}], \"answers\": [] },\n  \"expectedRevision\": null,\n  \"clientModifiedAt\": \"{{$isoTimestamp}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/applicants/me/drafts"
          }
        },
        {
          "name": "지원서 최종 제출",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('applicationId', pm.response.json().applicationId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"draftId\": {{draftId}}, \"postingId\": {{postingId}}, \"roleIds\": [{{roleId}}],\n  \"answers\": [\n    { \"key\": \"NAME\", \"value\": \"지원자\" }, { \"key\": \"PHONE\", \"value\": \"010-1234-5678\" },\n    { \"key\": \"BIRTH\", \"value\": \"2000-01-01\" }, { \"key\": \"GENDER\", \"value\": \"FEMALE\" },\n    { \"key\": \"BODY\", \"value\": { \"height\": 170, \"weight\": 60 } },\n    { \"key\": \"EMAIL\", \"value\": \"{{applicantEmail}}\" }, { \"key\": \"RESIDENCE\", \"value\": \"서울\" }\n  ],\n  \"consent\": { \"collectionAndUse\": true, \"thirdPartyProvision\": true, \"profileSave\": false }\n}" },
            "url": "{{baseUrl}}/api/v1/applicants/me/applications"
          }
        },
        { "name": "내 지원서 목록", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/applicants/me/applications" } },
        { "name": "내 지원서 상세", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/applicants/me/applications/{{applicationId}}" } }
      ]
    },
    {
      "name": "04. 공연사 심사",
      "item": [
        {
          "name": "공연사 다시 로그인",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{producerEmail}}\",\n  \"password\": \"{{producerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/sessions"
          }
        },
        { "name": "현재 심사 보드", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/roles/{{roleId}}/screening-rounds/current/applications" } },
        {
          "name": "1차 합격 저장",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"applicationIds\": [{{applicationId}}], \"status\": \"PASS\", \"memo\": \"\", \"note\": \"Postman 검증\" }" },
            "url": "{{baseUrl}}/api/v1/roles/{{roleId}}/screening-rounds/1/reviews"
          }
        },
        {
          "name": "1차 마감",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"CLOSED\" }" },
            "url": "{{baseUrl}}/api/v1/roles/{{roleId}}/screening-rounds/1"
          }
        }
      ]
    }
  ]
}
