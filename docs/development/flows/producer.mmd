---
config:
  layout: elk
---
flowchart TB
    START(["기획사/제작사 시작"]) --> SESSION["세션 확인<br>GET /api/v1/sessions/current"]
    SESSION -- 세션 없음 --> LOGIN["이메일·비밀번호 로그인<br>POST /api/v1/sessions"]
    LOGIN --> PASSWORD_RESET["비밀번호 재설정 화면<br>이메일 인증 → 새 비밀번호 확인 입력<br>현재 프론트 프로토타입"]
    PASSWORD_RESET --> LOGIN
    LOGIN --> SESSION
    SESSION -- 기획사/제작사 미가입 --> SIGNUP["기획사/제작사명·휴대폰·이메일·비밀번호 가입<br>POST /api/v1/producers"]
    SIGNUP --> AUTO_LOGIN["ACTIVE 계정 생성 후 즉시 로그인<br>POST /api/v1/sessions"]
    AUTO_LOGIN --> SESSION
    SESSION -- PENDING<br>향후 인증 도입 시 --> PENDING["기획사/제작사 인증 대기"]
    PENDING --> PROFILE["기획사/제작사 정보 설정 가능<br>GET·PATCH /api/v1/producers/me"]
    PENDING --> BLOCKED["공연 조회·관리 차단<br>기획사·제작사 인증 안내"]
    BLOCKED --> CONTACT["카카오톡 채널 문의<br>운영진 수동 확인"]
    CONTACT --> ACTIVE{"ACTIVE 전환?"}
    ACTIVE -- 아니오 --> PENDING
    ACTIVE -- 예 --> HOME["관리자 홈"]
    SESSION -- ACTIVE --> HOME
    HOME --> NAV["왼쪽 사이드바 초기 접힘 탐색 트리<br>GET /api/v1/producers/me/navigation-tree"] & PROFILE & PERF["공연 카드 목록<br>GET /api/v1/performances"]
    PERF --> NEW_PERF["공연 작성 로컬 자동저장 600ms<br>등록 성공 때 로컬 Draft 삭제<br>POST /api/v1/performance-posters/upload-requests<br>Presigned URL 직접 업로드<br>PATCH /api/v1/performance-posters/{fileId}/completion<br>POST /api/v1/performances"] & EDIT_PERF["공연 상세 조회 후 기본 정보·포스터 수정<br>GET /api/v1/performances/{performanceId}<br>POST /api/v1/performance-posters/upload-requests<br>Presigned URL 직접 업로드<br>PATCH /api/v1/performance-posters/{fileId}/completion<br>PUT /api/v1/performances/{performanceId}<br>배역은 읽기 전용"] & POSTINGS["공연 카드 선택 → 공고 관리<br>GET /api/v1/auditions?performanceId={performanceId}&phase={phase}&keyword={keyword}"]
    NEW_PERF --> CREATE_PERF["공연 등록"]
    POSTINGS --> CREATE_POSTING["공고 작성 로컬 자동저장 600ms<br>서버 DRAFT 생성·수정은 별도 계약<br>POST /api/v1/auditions"] & POSTING_DETAIL["공고 DRAFT 상세<br>GET /api/v1/auditions/{auditionId}"]
    POSTING_DETAIL --> EDIT_POLICY{"모집 화면 상태?"} & PUBLISH["전체 섹션·마감 확인 후 게시<br>배역명 스냅샷 확정<br>PUT /api/v1/auditions/{auditionId}/publication"] & ROLES["게시 후 배역별 지원 현황"]
    EDIT_POLICY -- UPCOMING --> EDIT_POSTING["모든 공고 항목 수정<br>섹션별 PUT"]
    EDIT_POLICY -- OPEN --> EDIT_OPEN["공고명·모집 종료 연장만 허용<br>시작·단축·지원 폼·배역·전형 수정 불가"]
    EDIT_POLICY -- RECRUIT_CLOSED --> EDIT_BLOCKED["모든 항목 수정 불가"]
    EDIT_POSTING --> PUBLISH
    ROLES --> CHOOSE_ROLE["심사할 배역 선택<br>배역이 하나여도 동일하게 표시"]
    CHOOSE_ROLE --> BOARD["배역별 심사 보드<br>복수 배역 지원서는 각 배역에 표시<br>GET /api/v1/audition-roles/{roleId}/screening-rounds/{round}/submissions"]
    BOARD --> RESULT_FILTER["검토 완료 → 결과 조건 선택<br>합격·불합격·불참·기타"]
    RESULT_FILTER --> GROUP_ACTION["현재 결과 목록 일괄 작업<br>전체 인쇄 또는 연락처 모아보기"]
    BOARD --> MORE{"다음 페이지 필요?"}
    MORE -- 예: cursor --> BOARD
    MORE -- 아니오 --> SELECT["배우 선택"]
    SELECT --> APP_DETAIL["지원자 심사 상세 페이지로 이동<br>GET /api/v1/audition-roles/{roleId}/screening-rounds/{round}/submissions/{submissionId}"]
    APP_DETAIL --> REVIEW["심사 저장<br>현재: 결과 일괄 영속화<br>[목표] expectedVersion 검증<br>PATCH /api/v1/audition-roles/{roleId}/screening-rounds/{round}/reviews"]
    REVIEW -- "[목표] 409 VERSION_CONFLICT" --> BOARD
    REVIEW -- "[목표] 성공: delta·counts·version" --> DONE{"검토 대기 0명?"}
    DONE -- 아니오 --> SELECT
    DONE -- 예 --> CLOSE["[목표] 차수 마감 + expectedVersion<br>PATCH /api/v1/audition-roles/{roleId}/screening-rounds/{round}<br>status=CLOSED"]
    CLOSE -- "[목표] 409 VERSION_CONFLICT" --> BOARD
    CLOSE --> LAST{"마지막 차수?"}
    LAST -- 아니오 --> BOARD
    LAST -- 예 --> FINISH(["전형 종료"])

    classDef authNode stroke:#818cf8,fill:#eef2ff
    classDef perfNode stroke:#2dd4bf,fill:#f0fdfa
    classDef postingNode stroke:#a78bfa,fill:#f5f3ff
    classDef screeningNode stroke:#fb923c,fill:#fff7ed
    classDef decisionNode stroke:#f87171,fill:#fef2f2
    class START,SESSION,LOGIN,PASSWORD_RESET,SIGNUP,AUTO_LOGIN,PENDING,PROFILE,BLOCKED,CONTACT,HOME,FINISH authNode
    class ACTIVE,MORE,DONE,LAST,EDIT_POLICY decisionNode
    class NAV,PERF,NEW_PERF,EDIT_PERF,CREATE_PERF perfNode
    class POSTINGS,CREATE_POSTING,POSTING_DETAIL,EDIT_POSTING,EDIT_OPEN,EDIT_BLOCKED,PUBLISH,ROLES postingNode
    class BOARD,CHOOSE_ROLE,RESULT_FILTER,GROUP_ACTION,SELECT,APP_DETAIL,REVIEW,CLOSE screeningNode
