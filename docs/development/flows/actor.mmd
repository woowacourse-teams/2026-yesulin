---
config:
  layout: elk
---
flowchart TB
    START(["배우 시작"]) --> PUBLIC["외부 링크로 공개 공고 확인<br>GET /api/v1/public/auditions/{auditionId}"]
    PUBLIC --> OPEN{"모집 중?"}
    OPEN -- 아니오 --> RECOMMEND["다른 공고 확인<br>GET /api/v1/public/recommended-auditions"]
    OPEN -- 예 --> MULTI{"배역 여러 개?"}
    MULTI -- 예 --> ROLE["배역 선택<br>공고 허용 시 복수 선택"]
    MULTI -- 아니오 --> MEMBER{"로그인 세션?"}
    ROLE --> MEMBER
    MEMBER -- 예 --> PREFILL["프로필 자동 채움<br>GET /api/v1/applicants/me/profile/prefill"]
    MEMBER -- 아니오 --> START_CHOICE{"로그인 후 프로필을<br>불러와 작성할까요?"}
    START_CHOICE -- 로그인 --> LOGIN["카카오·네이버·Google 소셜 로그인<br>첫 로그인 시 배우 계정 자동 생성"]
    LOGIN --> PREFILL
    START_CHOICE -- 로그인 없이 작성 --> FORM["지원서 작성·사진 선택<br>IndexedDB 우선 저장"]
    PREFILL --> FORM
    FORM --> DRAFT["로컬 Draft 저장<br>인증 전 IndexedDB에만 보관"]
    DRAFT --> RESTORE["Draft 복원 시<br>동의 체크·프로필 갱신 선택 초기화"]
    RESTORE --> REVIEW["최종 검토·필수 동의<br>프로필 보관·이번 값 갱신은 별도 선택"]
    REVIEW --> AUTH{"제출 시 로그인 상태?"}
    AUTH -- 아니오 --> SOCIAL["소셜 로그인<br>첫 로그인 시 계정 자동 생성"]
    SOCIAL --> UPLOAD["최종 제출 자료 전송<br>사진·영상은 requirementId로 연결"]
    AUTH -- 예 --> UPLOAD
    UPLOAD --> FINAL_OPEN{"제출 클릭 시 서버 UTC 기준<br>모집 중·만 14세 이상?"}
    FINAL_OPEN -- 아니오 --> BLOCKED["제출 즉시 차단<br>로컬 Draft는 이 기기에 유지"]
    FINAL_OPEN -- 예 --> SUBMIT["텍스트·나이·배역명·파일 참조<br>불변 스냅샷 제출"]
    SUBMIT --> RECEIPT["접수 완료"]
    RECEIPT --> HOME["배우 홈"]
    HOME --> PROFILE["프로필 조회·수정<br>기본정보·추가정보"] & APPLICATIONS["내 지원서 목록<br>로컬 Draft + 제출 스냅샷"] & RECOMMEND
    PROFILE --> LIBRARY["개인 사진·영상 보관함<br>지원서의 프로필 갱신 범위와 분리"]
    APPLICATIONS --> RESUME["작성 중 Draft<br>이 기기에서 이어쓰기"] & DETAIL["제출 스냅샷·배역별 전형 확인<br>GET /api/v1/applicants/me/submissions/{submissionId}"]
    DETAIL --> READONLY["읽기 전용 확인"]

    classDef publicNode stroke:#2dd4bf,fill:#f0fdfa
    classDef accountNode stroke:#818cf8,fill:#eef2ff
    classDef applicationNode stroke:#fb923c,fill:#fff7ed
    classDef decisionNode stroke:#f87171,fill:#fef2f2
    START:::accountNode
    PUBLIC:::publicNode
    OPEN:::decisionNode
    RECOMMEND:::publicNode
    ROLE:::applicationNode
    MULTI:::decisionNode
    MEMBER:::decisionNode
    PREFILL:::applicationNode
    FORM:::applicationNode
    START_CHOICE:::decisionNode
    AUTH:::decisionNode
    SUBMIT:::applicationNode
    RECEIPT:::applicationNode
    SOCIAL:::accountNode
    DRAFT:::applicationNode
    RESTORE:::applicationNode
    REVIEW:::applicationNode
    UPLOAD:::applicationNode
    FINAL_OPEN:::decisionNode
    BLOCKED:::applicationNode
    LOGIN:::accountNode
    HOME:::accountNode
    PROFILE:::accountNode
    LIBRARY:::accountNode
    APPLICATIONS:::applicationNode
    RESUME:::applicationNode
    DETAIL:::applicationNode
    READONLY:::applicationNode
