---
config:
  layout: elk
---
flowchart TB
    START(["지원자 시작"]) --> PUBLIC["외부 링크로 공개 공고 확인<br>GET /api/v1/public/postings/{postingId}"]
    PUBLIC --> OPEN{"모집 중?"}
    OPEN -- 아니오 --> RECOMMEND["다른 공고 확인<br>GET /api/v1/public/recommended-postings"]
    OPEN -- 예 --> ROLE["배역 선택"]
    ROLE --> MEMBER{"로그인 세션?"}
    MEMBER -- 예 --> PREFILL["프로필 자동 채움<br>GET /api/v1/applicants/me/profile/prefill"]
    MEMBER -- 아니오 --> LOAD{"이전 기본 프로필을<br>불러올까요?"}
    LOAD -- 예 --> LOGIN["로그인"]
    LOGIN --> PREFILL
    LOAD -- 아니오 --> FORM["지원서 작성"]
    PREFILL --> FORM
    FORM --> AUTH{"제출 시 로그인 상태?"}
    AUTH -- 아니오 --> SIGNUP["로그인 또는 회원가입"]
    AUTH -- 예 --> SUBMIT["지원서 제출<br>인증 기반 API 계약 결정 필요"]
    SIGNUP --> SUBMIT
    SUBMIT --> RECEIPT["접수 완료"]
    RECEIPT --> HOME["지원자 홈"]
    HOME --> PROFILE["프로필 조회·수정<br>GET·PATCH /api/v1/applicants/me/profile"] & APPLICATIONS["내 지원서 목록<br>GET /api/v1/applicants/me/applications"] & RECOMMEND
    APPLICATIONS --> DETAIL["제출 스냅샷 확인<br>GET /api/v1/applicants/me/applications/{applicationId}"]
    DETAIL --> READONLY["읽기 전용 확인"]

    classDef publicNode stroke:#2dd4bf,fill:#f0fdfa
    classDef accountNode stroke:#818cf8,fill:#eef2ff
    classDef applicationNode stroke:#fb923c,fill:#fff7ed
    classDef decisionNode stroke:#f87171,fill:#fef2f2
    START:::accountNode
    PUBLIC:::publicNode
    OPEN:::decisionNode
    RECOMMEND:::publicNode
    ROLE:::applicationNode
    MEMBER:::decisionNode
    PREFILL:::applicationNode
    FORM:::applicationNode
    LOAD:::decisionNode
    AUTH:::decisionNode
    SUBMIT:::applicationNode
    RECEIPT:::applicationNode
    SIGNUP:::accountNode
    LOGIN:::accountNode
    HOME:::accountNode
    PROFILE:::accountNode
    APPLICATIONS:::applicationNode
    DETAIL:::applicationNode
    READONLY:::applicationNode
